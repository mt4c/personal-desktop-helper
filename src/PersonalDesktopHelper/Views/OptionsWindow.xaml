<Window x:Class="PersonalDesktopHelper.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="470" Width="850" MinHeight="350" MinWidth="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl>
            <TabItem Header="Notifications">
                <StackPanel Margin="16">
                    <CheckBox x:Name="NotificationsCheckBox" Content="Show notifications"
                              Click="OnNotificationsClick" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="This setting also controls the tray menu toggle. Windows notification settings may suppress notification display." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Scheduler">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="OnTaskSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="1.3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Next run (local)" Binding="{Binding NextRun}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ToggleTaskButton" Content="Disable" MinWidth="90"
                                IsEnabled="False" Click="OnToggleTaskClick" />
                        <Button x:Name="DeleteTaskButton" Content="Delete" MinWidth="90" Margin="8,0,0,0"
                                IsEnabled="False" Click="OnDeleteTaskClick" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Disabling or deleting a task prevents future runs. A run already in progress is allowed to finish. Missed runs are skipped on startup." />
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StoragePathText" Grid.Row="1" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="DimGray" />
    </Grid>
</Window>

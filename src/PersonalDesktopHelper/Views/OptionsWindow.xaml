<Window x:Class="PersonalDesktopHelper.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="650" Width="950" MinHeight="450" MinWidth="750"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="OptionsTabs">
            <TabItem Header="Notifications">
                <StackPanel Margin="16">
                    <CheckBox x:Name="NotificationsCheckBox" Content="Show notifications"
                              Click="OnNotificationsClick" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="This setting also controls the tray menu toggle. Windows notification settings may suppress notification display." />
                </StackPanel>
            </TabItem>
            <TabItem Header="Scheduler">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              SelectionChanged="OnTaskSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="1.3*" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                            <DataGridTextColumn Header="Next run (local)" Binding="{Binding NextRun}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ToggleTaskButton" Content="Disable" MinWidth="90"
                                IsEnabled="False" Click="OnToggleTaskClick" />
                        <Button x:Name="DeleteTaskButton" Content="Delete" MinWidth="90" Margin="8,0,0,0"
                                IsEnabled="False" Click="OnDeleteTaskClick" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap"
                               Text="Disabling or deleting a task prevents future runs. A run already in progress is allowed to finish. Missed runs are skipped on startup." />
                </Grid>
            </TabItem>
            <TabItem x:Name="CopilotTab" Header="Copilot">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CopilotPanel" Margin="16">
                        <TextBlock Text="Sign in to GitHub to use your Copilot subscription."
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,14" TextWrapping="Wrap"
                                   Text="Sign in displays a device code. Open the GitHub sign-in page and authorize the app. Your saved sign-in is encrypted for this Windows user, separately from settings." />
                        <StackPanel IsEnabled="{Binding CanConfigure}">
                            <TextBlock Text="Chat model (leave blank for automatic selection; connect to load available models)" />
                            <ComboBox x:Name="CopilotModelComboBox" IsEditable="True"
                                      ItemsSource="{Binding Models}" Margin="0,5,0,12" Padding="6" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Saving changed settings starts a new chat. Copilot can use notification and scheduler MCP tools without confirmation. There are no shell or arbitrary file-access tools." />
                        <WrapPanel Margin="0,12,0,12">
                            <Button Content="Sign in" Padding="12,5" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanConfigure}" Click="OnSignInCopilotClick" />
                            <Button Content="Sign out" Padding="12,5" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanConfigure}" Click="OnSignOutCopilotClick" />
                            <Button x:Name="SaveCopilotSettingsButton" Content="Save settings" Padding="12,5" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanConfigure}" Click="OnSaveCopilotClick" />
                            <Button Content="Connect" Padding="12,5" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanConfigure}" Click="OnConnectCopilotClick" />
                            <Button Content="Disconnect" Padding="12,5" Margin="0,0,8,0"
                                    IsEnabled="{Binding CanDisconnect}" Click="OnDisconnectCopilotClick" />
                            <Button Content="Stop" Padding="12,5"
                                    IsEnabled="{Binding IsBusy}" Click="OnStopCopilotClick" />
                        </WrapPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="Open sign-in page" Padding="12,5"
                                    IsEnabled="{Binding HasDeviceCode}" Click="OnOpenSignInPageClick" />
                            <TextBox Text="{Binding UserCode, Mode=OneWay}" IsReadOnly="True"
                                     FontSize="18" FontWeight="SemiBold" Padding="6" Margin="0,0,8,0"
                                     ToolTip="Copy this code and enter it on the GitHub sign-in page." />
                        </DockPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="DimGray" />
                        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="Firebrick" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SystemPromptTab" Header="System prompt">
                <Grid x:Name="SystemPromptPanel" Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Constant instructions and MCP tool definitions (read-only)" Margin="0,0,0,5" />
                    <TextBox x:Name="ConstantPromptTextBox" Grid.Row="1"
                             Text="{Binding ConstantSystemPrompt, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" />
                    <TextBlock Grid.Row="2" Text="Your additional instructions (editable)" Margin="0,10,0,5" />
                    <TextBox x:Name="EditablePromptTextBox" Grid.Row="3" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6"
                             IsEnabled="{Binding CanConfigure}" TextChanged="OnSystemPromptTextChanged" />
                    <TextBlock Grid.Row="4" Text="Combined system prompt preview" Margin="0,10,0,5" />
                    <TextBox x:Name="CombinedPromptTextBox" Grid.Row="5" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="6" />
                    <DockPanel Grid.Row="6" Margin="0,10,0,0">
                        <Button x:Name="SaveSystemPromptButton" DockPanel.Dock="Right" Content="Save system prompt"
                                Padding="12,5" IsEnabled="{Binding CanConfigure}" Click="OnSaveSystemPromptClick" />
                        <TextBlock Text="Saving changes starts a new chat. Module actions execute without confirmation."
                                   Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                    <StackPanel Grid.Row="7" Margin="0,8,0,0">
                        <TextBlock Text="{Binding Status}" Foreground="DimGray" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StoragePathText" Grid.Row="1" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="DimGray" />
    </Grid>
</Window>

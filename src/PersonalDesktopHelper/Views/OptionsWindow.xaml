<Window x:Class="PersonalDesktopHelper.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="Options" Height="780" Width="1060" MinHeight="700" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Make it yours" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Your assistant, your preferences." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
        <TabControl x:Name="OptionsTabs" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <TabItem Header="Notifications">
                <StackPanel Margin="24,0,0,0">
                    <TextBlock Text="Stay in the loop" FontSize="23" FontWeight="SemiBold" />
                    <TextBlock Text="Choose when your desktop assistant can notify you." TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,22" />
                    <Border Style="{StaticResource CardStyle}" Padding="22">
                        <StackPanel>
                            <CheckBox x:Name="NotificationsCheckBox" Content="Show desktop notifications"
                                      FontWeight="SemiBold" Click="OnNotificationsClick" />
                            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                       Text="Reminders and scheduled notifications appear in the Windows notification area. This setting stays in sync with the tray menu." />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="18" Margin="0,16,0,0">
                        <TextBlock Text="Windows notification settings and Do Not Disturb may still suppress delivery."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </TabItem>
            <TabItem Header="Scheduler">
                <Grid Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="A little planning goes a long way" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Manage reminders and routines in one place." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="8">
                        <Grid>
                            <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False"
                                      SelectionMode="Single" SelectionUnit="FullRow"
                                      SelectionChanged="OnTaskSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Schedule" Binding="{Binding Schedule}" Width="1.3*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                    <DataGridTextColumn Header="Next run (local)" Binding="{Binding NextRun}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,62,20,20" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=TasksGrid}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Your schedule is clear" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="Ask Copilot to create a reminder to get started." TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button x:Name="ToggleTaskButton" Content="Disable" MinWidth="90"
                                IsEnabled="False" Click="OnToggleTaskClick" />
                        <Button x:Name="DeleteTaskButton" Content="Delete" MinWidth="90" Margin="8,0,0,0"
                                Style="{StaticResource DangerButtonStyle}"
                                IsEnabled="False" Click="OnDeleteTaskClick" />
                    </StackPanel>
                    <TextBlock Grid.Row="3" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                               Text="Disabling or deleting a task prevents future runs. A run already in progress is allowed to finish. Missed runs are skipped on startup." />
                </Grid>
            </TabItem>
            <TabItem x:Name="CopilotTab" Header="Copilot">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CopilotPanel" Margin="24,0,12,0">
                        <TextBlock Text="Your Copilot workspace" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Connect your account and find the model that works for you." TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,22" />
                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Account &amp; connection" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                                <Border Background="{StaticResource SubtleSurfaceBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock x:Name="CopilotSignInStatusText" FontWeight="SemiBold"
                                                   Text="{Binding SignInStatus, StringFormat='GitHub: {0}'}" TextWrapping="Wrap" />
                                        <TextBlock x:Name="CopilotConnectionStatusText" Margin="0,6,0,0"
                                                   Text="{Binding ConnectionStatus, StringFormat='Copilot: {0}'}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{Binding SetupGuidance}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="SignInCopilotButton" Content="Sign in" Margin="0,0,8,8"
                                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanSignIn}" Click="OnSignInCopilotClick" />
                                    <Button x:Name="ConnectCopilotButton" Content="Connect" Margin="0,0,8,8"
                                            Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanConnect}" Click="OnConnectCopilotClick" />
                                    <Button x:Name="DisconnectCopilotButton" Content="Disconnect" Margin="0,0,8,8"
                                            IsEnabled="{Binding CanDisconnect}" Click="OnDisconnectCopilotClick" />
                                    <Button x:Name="SignOutCopilotButton" Content="Sign out" Margin="0,0,8,8"
                                            Style="{StaticResource DangerButtonStyle}" IsEnabled="{Binding CanSignOut}" Click="OnSignOutCopilotClick" />
                                    <Button Content="Stop" Margin="0,0,0,8" IsEnabled="{Binding IsBusy}" Click="OnStopCopilotClick" />
                                </WrapPanel>
                                <DockPanel Margin="0,8,0,14">
                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasDeviceCode}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                    <Button DockPanel.Dock="Right" Content="Open sign-in page"
                                            IsEnabled="{Binding HasDeviceCode}" Click="OnOpenSignInPageClick" />
                                    <TextBox Text="{Binding UserCode, Mode=OneWay}" IsReadOnly="True"
                                             FontSize="18" FontWeight="SemiBold" Margin="0,0,12,0"
                                             AutomationProperties.Name="GitHub device code"
                                             ToolTip="Copy this code and enter it on the GitHub sign-in page." />
                                </DockPanel>
                                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,16">
                            <StackPanel IsEnabled="{Binding CanConfigure}">
                                <TextBlock Text="Preferred model" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Connect to load available models. Leave blank for automatic selection." TextWrapping="Wrap"
                                           Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,12" />
                                <ComboBox x:Name="CopilotModelComboBox" IsEditable="True" ItemsSource="{Binding Models}"
                                          SelectionChanged="OnCopilotModelSelectionChanged" AutomationProperties.Name="Preferred chat model" />
                                <DockPanel Margin="0,12,0,0">
                                    <Button x:Name="SaveCopilotSettingsButton" DockPanel.Dock="Right" Content="Save settings" Margin="16,0,0,0"
                                            IsEnabled="{Binding CanConfigure}" Click="OnSaveCopilotClick" />
                                    <TextBlock Text="Listed models save automatically. Save settings to use a typed model or automatic selection."
                                               FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Good to know" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                                           Text="Your saved sign-in is encrypted for this Windows user. Changing settings starts a new chat. Copilot can manage notifications and schedules without confirmation, but cannot run shell commands or access arbitrary files." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="SystemPromptTab" Header="System prompt">
                <Grid x:Name="SystemPromptPanel" Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="Give your assistant direction" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="Shape the way Copilot responds to you." Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="Built-in instructions / read-only" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBox x:Name="ConstantPromptTextBox" Grid.Row="2" MinHeight="60" Background="{StaticResource SubtleSurfaceBrush}"
                             Text="{Binding ConstantSystemPrompt, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Built-in instructions" />
                    <TextBlock Grid.Row="3" Text="Your additional instructions" FontWeight="SemiBold" Margin="0,14,0,8" />
                    <TextBox x:Name="EditablePromptTextBox" Grid.Row="4" MinHeight="60" AcceptsReturn="True" AcceptsTab="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Your additional instructions"
                             IsEnabled="{Binding CanConfigure}" TextChanged="OnSystemPromptTextChanged" />
                    <TextBlock Grid.Row="5" Text="Combined prompt / preview" FontWeight="SemiBold" Margin="0,14,0,8" />
                    <TextBox x:Name="CombinedPromptTextBox" Grid.Row="6" MinHeight="60" IsReadOnly="True" Background="{StaticResource SubtleSurfaceBrush}"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Combined prompt preview" />
                    <DockPanel Grid.Row="7" Margin="0,16,0,0">
                        <Button x:Name="SaveSystemPromptButton" DockPanel.Dock="Right" Content="Save system prompt"
                                Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{Binding CanConfigure}" Click="OnSaveSystemPromptClick" />
                        <TextBlock Text="Saving changes starts a new chat. Module actions execute without confirmation."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Grid.Row="8" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="StoragePathText" Grid.Row="2" Margin="0,20,0,0" FontSize="11"
                   TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
    </Grid>
</Window>
